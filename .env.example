# Copy to .env — every value is optional. The app runs fully offline with none of them set.

# ---- Extraction engine -------------------------------------------------------
# rules -> local RapidOCR + rule-based parser only (default behaviour without a key)
# llm   -> local OCR, then refine with a FREE OpenRouter model (needs OPENROUTER_API_KEY)
# auto  -> llm if a key is present, otherwise rules
EXTRACTION_ENGINE=auto

# Free OpenRouter key (https://openrouter.ai/keys). Only ":free" models are used; no paid APIs.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_TIMEOUT_S=25

# ---- Storage ---------------------------------------------------------------------
# RECEIPTIQ_DATA_DIR=./data
# RECEIPTIQ_DB_PATH=./data/receipts.db
# RECEIPTIQ_UPLOAD_DIR=./data/uploads
# RECEIPTIQ_MAX_UPLOAD_MB=10

# ---- Part 2: Expense Dispatcher (only needed without --dry-run) --------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=          # Gmail "App password" (Google Account -> Security -> 2-Step -> App passwords)
SMTP_FROM=you@gmail.com
